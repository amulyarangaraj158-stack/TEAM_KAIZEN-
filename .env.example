# GEMINI_API_KEY: Required for Google Gemini AI code analysis, patch generation, and recommendations.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JWT_SECRET: Secret key for signing JWT authentication tokens (auto-generated fallback used in dev if omitted).
JWT_SECRET="change-me-in-production-use-64-char-random-hex"

# PORT: Server listening port (must remain 3000 in AI Studio preview).
PORT="3000"

# APP_URL: Public URL of the deployed application.
APP_URL="http://localhost:3000"

# DATABASE_PATH: Path to the SQLite database file.
DATABASE_PATH="./data/autopatch.db"
